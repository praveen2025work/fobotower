{
  "name": "Agent One Finance",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "api",
      "command": "cd apps/backend && .venv/bin/uvicorn agent_one_finance.web.main:app --host 0.0.0.0 --port 8300 --reload"
    },
    {
      "name": "console",
      "command": "cd apps/web && npm run dev -- --host 0.0.0.0 --port 3100 --strictPort"
    }
  ],
  "ports": [
    { "name": "console", "port": 3100 },
    { "name": "api", "port": 8300 },
    { "name": "postgres", "port": 5433 }
  ]
}
