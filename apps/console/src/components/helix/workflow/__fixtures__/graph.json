  "router": {
    "rule": "After a step that can escalate: if the step set outcome = escalated the run goes to Escalate and ends; otherwise it continues to the next configured step.",
    "defined_in": "apps/api/app/workflow/graph.py · _router"
  },
  "logic": {
    "resolve": {
      "escalates_when": [
        {
          "code": "UNRESOLVED_BOOK",
          "when": "no book matches"
        },
        {
          "code": "AMBIGUOUS_BOOK",
          "when": "more than one matches; never auto-picked"
        }
      ],
      "defined_in": "apps/api/app/workflow/nodes/resolve.py · resolve"
    },
    "gather": {
      "escalates_when": [
        {
          "code": "DELTA_UNAVAILABLE",
          "when": "a break leg is missing, so no delta to explain"
        },
        {
          "code": "CHECKS_UNAVAILABLE",
          "when": "the cause checks did not all run"
        }
      ],
      "defined_in": "apps/api/app/workflow/nodes/gather.py · gather"
    },
