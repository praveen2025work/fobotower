    "guards": [
      {
        "id": "§8",
        "rule": "A rejected legitimate posting is corrected and re-posted, not judged"
      },
      {
        "id": "R6",
        "rule": "No evidenced root cause: escalate, do not post"
      },
      {
        "id": "R2",
        "rule": "A Front Office cause never posts a FOBO adjustment: do not post"
      },
      {
        "id": "none",
        "rule": "No verdict proposed at all is an escalation, never an implicit POST"
      },
