    },
    "escalate": {
      "reasons": [
        "AMBIGUOUS_BOOK",
        "CHECKS_UNAVAILABLE",
        "DELTA_UNAVAILABLE",
        "RETRY_EXHAUSTED",
        "UNMAPPED_BOOK",
        "UNRESOLVED_BOOK",
        "VALIDATION_FAILED"
      ],
      "defined_in": "apps/api/app/workflow/nodes/escalate.py · escalate"
