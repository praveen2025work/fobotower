  "decision": {
    "defined_in": [
      "apps/api/app/reasoning/determinism.py · classify",
      "apps/api/app/reasoning/guards.py · guard_verdict"
    ],
    "patterns": [
      {
        "code": "posting_failure",
        "meaning": "MOTIF rejected a posting that should have occurred"
      },
      {
        "code": "missing_side",
        "meaning": "One side of the break is absent entirely"
      },
      {
        "code": "missing_price",
        "meaning": "Price is zero and no corporate action is confirmed"
      },
      {
        "code": "side_double",
        "meaning": "The same side is duplicated"
      },
      {
        "code": "reapplication",
        "meaning": "Today's break matches a prior-day adjustment rolling forward"
      },
      {
        "code": "single_cause",
        "meaning": "Exactly one cause check fired"
      }
    ],
    "cause_checks": [
