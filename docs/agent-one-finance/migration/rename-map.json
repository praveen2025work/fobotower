      "aof."
    ],
    [
      "\"helix\\*\"",
      "\"agent_one_finance*\""
    ],
    [
      "(?<![A-Za-z0-9])Helix(?=[A-Za-z0-9_])",
      "Aof"
    ],
    [
      "(?<![A-Za-z0-9])Helix's\\b",
      "Agent One Finance's"
    ],
    [
      "(?<![A-Za-z0-9])Helix(?![A-Za-z0-9_])",
      "Agent One Finance"
    ],
    [
