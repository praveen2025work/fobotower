  "patterns": [
    [
      "\\bfrom helix\\b",
      "from agent_one_finance"
    ],
    [
      "\\bimport helix\\b",
      "import agent_one_finance"
    ],
    [
      "\\bhelix\\.(?=(?:{modules})\\b)",
      "agent_one_finance."
    ],
    [
      "(?<![A-Za-z0-9_/.-])helix/(?=(?:{modules})\\b)",
      "agent_one_finance/"
    ],
