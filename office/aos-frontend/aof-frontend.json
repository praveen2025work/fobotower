{
  "about": "The Agent One Finance console in the office's Agent One frontend shape. Made by apps/web/office/convert.mjs; copied into aos-frontend by aof_sync.py.",
  "root": "#aof-root",
  "routes": [
    {
      "path": "/finance",
      "page": "pages/Overview"
    },
    {
      "path": "/finance/inbox",
      "page": "pages/Inbox"
    },
    {
      "path": "/finance/capabilities",
      "page": "pages/Capabilities"
    },
    {
      "path": "/finance/capabilities/:id",
      "page": "pages/CapabilityDetail"
    },
    {
      "path": "/finance/capabilities/:id/groups/:group",
      "page": "pages/GroupDetail"
    },
    {
      "path": "/finance/cases/:caseId",
      "page": "pages/CaseWorkspace"
    },
    {
      "path": "/finance/authoring",
      "page": "pages/Authoring"
    },
    {
      "path": "/finance/operations",
      "page": "pages/Operations"
    },
    {
      "path": "/finance/audit",
      "page": "pages/Audit"
    },
    {
      "path": "/finance/connectors",
      "page": "pages/Connectors"
    }
  ],
